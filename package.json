{
  "name": "@local/dsh-retrieval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read any page the free way first: official APIs, then static extraction, then a reader service, then a real browser, with the layer that answered reported back.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "extension",
    "docs",
    "icon.svg",
    "README.md",
    "scripts",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
